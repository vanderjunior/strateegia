APP_ENV=development
DATA_DIR=data
ENABLE_INSPECTION=true
REQUIRE_AUTH_FOR_INSPECTION=false
INSPECTION_ALLOWED_IN_PRODUCTION=false
# Optional overrides. If omitted, these resolve below DATA_DIR.
STUDYFLOW_DATA_FILE=data/study_data.json
STUDYFLOW_UPLOAD_ROOT=data/uploads
ENABLE_PUBLIC_REGISTRATION=true
SESSION_COOKIE_SECURE=false
ENABLE_OCR=false
OCR_ENGINE=tesseract
OCR_LANGUAGE=por+eng
OCR_MAX_PAGES=5
OCR_RENDER_DPI=150

# Frontend/local Compose helpers
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_USE_MOCK_API=false
